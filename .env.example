# Copy to .env and fill in (or run `python install.py setup`, which writes .env for you).
# Commented lines show the default; uncomment to change one. An empty value is NOT the default
# (it overrides it), so delete a line rather than leaving it blank. See docs/INSTALL.md.
# Wrap values with spaces or special characters ( ) ! # % & $ in single quotes, e.g. KEY='a b', so
# `set -a; . ./.env; set +a` works in bash too (the app strips the quotes).

# --- Django -------------------------------------------------------------
DJANGO_DEBUG=0
# REQUIRED: a long random string (python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=''
# Comma separated. Default with DEBUG: localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=
# e.g. https://erp.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Extra apps to install, comma separated (e.g. core.seeder for demo data)
# DJANGO_EXTRA_APPS=
# DJANGO_TIME_ZONE=UTC
# HTTPS: redirect is on when DEBUG is off; HSTS 31536000 when DEBUG is off
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# Set to 1 behind nginx/a load balancer that sends X-Forwarded-Proto
# DJANGO_BEHIND_PROXY=0
# SESSION_COOKIE_AGE=43200
# LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# postgresql (default; pip install -r requirements-postgresql.txt), mysql (MySQL 8 / MariaDB 10.6+: pip install -r
# requirements-mysql.txt, DB_PORT=3306) or sqlite (no driver)
DB_ENGINE=postgresql
DB_NAME=core
DB_USER=core
DB_PASSWORD=''
DB_HOST=localhost
DB_PORT=5432
# DB_CONN_MAX_AGE=60

# --- Cache --------------------------------------------------------------
# File cache under the project unless REDIS_URL is set (e.g. redis://localhost:6379/1)
# CACHE_DIR=var/cache
# REDIS_URL=

# --- E-mail -------------------------------------------------------------
# Default: console backend with DEBUG, SMTP otherwise
# EMAIL_BACKEND=
# EMAIL_HOST=localhost
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=0
# DEFAULT_FROM_EMAIL=no-reply@example.invalid

# --- Background jobs (django-q2) ----------------------------------------
# Q_WORKERS=2
# Q_TIMEOUT=3600
# Q_RETRY=3700
# 1 = run jobs inline (no qcluster needed; dev only)
# Q_SYNC=0

# --- Core app -----------------------------------------------------------
# CORE_DATE_FORMAT='d-M-Y'
# CORE_DATETIME_FORMAT='d-M-Y h:i:s A'
# CORE_TIME_FORMAT='h:i:s A'
# Deepest sidebar menu level (1 = top level)
CORE_MENU_MAX_DEPTH=6
# Directories (empty = default under the project)
# CORE_PRIVATE_MEDIA_ROOT=
# CORE_BACKUP_DIR=
# CORE_ARCHIVE_DIR=
# Comma separated
# CORE_BACKUP_FILE_ROOTS=
# CORE_ARCHIVE_ALLOWED_TABLES=
# CORE_BACKUP_ALLOW_RESTORE=0
# Also e-mail notifications
# CORE_NOTIFY_EMAIL=0
